{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commit Warrior",
  "version": "2.1.0",
  "identifier": "com.developeraz.commitwarrior",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Commit Warrior",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "Commit Warrior Widget",
        "url": "/widget.html",
        "width": 320,
        "height": 236,
        "minWidth": 280,
        "minHeight": 200,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Anthony Zhou",
    "copyright": "Copyright © 2026 Anthony Zhou",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
